# DB의 주소를 입력하세요. (ex - mongodb://127.0.0.1:27017/~~ 또는 mongoDBAtlas의 주소)
DB_URL=

# app.listen()에 넣을 port 번호를 입력하세요. (ex - 3000)
PORT=

# cors 시 허용할 주소들을 ,(쉼표)로 구분하여 입력하세요. (ex - web page가 존재할 때 해당 web의 주소, localhost로 띄운 웹페이지 주소 등)
ALLOWED_ORIGINS=

# jwt token secret을 아래에 입력하세요. (다음 명령어로 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" )
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=