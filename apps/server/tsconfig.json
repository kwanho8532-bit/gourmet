{
  "compilerOptions": {
    /* 1. 빌드 및 파일 레이아웃 (1번 옵션의 핵심) */
    "rootDir": "./src", // 실제 작성할 ts 코드가 모여있는 폴더
    "outDir": "./dist", // 빌드된 js 파일이 저장될 폴더
    // ------------------------------------------------------------------------------------------------------------------------------------------------
    /* 2. 환경 및 모듈 시스템 (2번 옵션의 최신 표준 반영) */
    "target": "es2022", // 최신 Node.js가 지원하는 최고 사양의 JS로 컴파일
    "lib": [
      "ES2022"
    ], // 서버 환경이므로 browser 관련 api(DOM 등)를 완전히 배제하고 최신 JS 스펙만 제공
    "module": "commonjs", // 뒤에 확장자 .js 생략 가능 / nodejs 패키지들과의 최적화(호환성) 
    "moduleDetection": "force", // 파일 내부에 import나 export 문이 없어도 TypeScript가 프로젝트의 모든 .ts 파일을 자동으로 독립된 '모듈'로 강제 취급
    // ------------------------------------------------------------------------------------------------------------------------------------------------
    /* 3. 소스맵 및 선언 파일 (디폴트 옵션 유지) */
    "sourceMap": true, // 에러 발생 시 ts 라인 번호로 역추적하기 위해 필수
    "declaration": true, // pnpm 모노레포에서 다른 패키지(예: native)가 이 서버의 타입을 참조할 수 있도록 d.ts 생성
    "declarationMap": true, // 타입 정의 파일의 소스맵 생성
    // ------------------------------------------------------------------------------------------------------------------------------------------------
    /* 4. 엄격한 타입 검사 (안정성 극대화) */
    "strict": true, // 기본 엄격 모드 활성화
    "noUncheckedIndexedAccess": true, // 배열이나 객체 동적 접근 시 undefined 가능성을 강제 체크 (실무 런타임 에러 방지 1등 공신)
    "exactOptionalPropertyTypes": true, // optional 프로퍼티(? 표시)에 명시적으로 undefined를 대입하는 꼼수 차단
    // ------------------------------------------------------------------------------------------------------------------------------------------------
    /* 5. 호환성 및 속도 최적화 */
    "esModuleInterop": true, // CommonJS 라이브러리(import express)를 ESM 문법으로 매끄럽게 가져오기 위함
    "skipLibCheck": true, // node_modules 내부 라이브러리들의 타입 검사를 패스하여 컴파일/빌드 속도 대폭 향상
    "forceConsistentCasingInFileNames": true, // Windows/Mac 간의 파일 대소문자 구분 차이로 인한 빌드 에러 방지
    "isolatedModules": true // 각 파일을 독립적인 모듈로 안전하게 컴파일하도록 보장
  },
  "include": [
    "src/**/*"
  ] // src 폴더 하위의 모든 파일만 컴파일 대상에 포함
}